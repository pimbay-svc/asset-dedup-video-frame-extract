# development | production | test
NODE_ENV=production

# Log level for pino (trace|debug|info|warn|error|fatal|silent).
LOG_LEVEL=info

# Path of the Unix domain socket this extension listens on. Must be on a
# volume shared with asset-dedup-core (core connects to it as a client).
SOCKET_PATH=./var/dev/video-frame-extract.sock

# Base directory of the volume shared with asset-dedup-core: source videos
# are read from here, extracted frames are written here.
SHARED_VOLUME_DIR=./var/dev/shared

# Subdirectory (under SHARED_VOLUME_DIR) this extension writes extracted
# frames into. Defaults to SHARED_VOLUME_DIR/video-frame-extract if unset.
# OUTPUT_DIR=./var/dev/shared/video-frame-extract

# Safety backstop: videos longer than this are rejected as video_too_long.
# Not per-recipe anymore — recipes don't exist in this extension.
MAX_VIDEO_DURATION_S=3600

# Paths to the ffmpeg/ffprobe binaries. Default to relying on PATH.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Hard timeout (ms) for a single ffmpeg/ffprobe invocation (duration probe,
# scene-change probe, or a single frame extraction).
# FFMPEG_TIMEOUT_MS=20000

# Background TTL sweep of OUTPUT_DIR — defensive backstop if core crashes
# mid-pipeline before consuming/deleting our output.
# TTL_SWEEP_INTERVAL_MS=300000
# TTL_RETENTION_MS=3600000
