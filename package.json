{
  "name": "@pimbay/asset-dedup-video-frame-extract",
  "private": true,
  "version": "1.0.1",
  "description": "Video extension for asset-dedup-core — extracts frames from videos over a Unix domain socket.",
  "license": "Unlicense",
  "author": {
    "name": "Jan Sarmir",
    "email": "sarmir@pimbay.dev",
    "url": "https://pimbay.dev"
  },
  "homepage": "https://pimbay.dev",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/pimbay-svc/asset-dedup-video-frame-extract"
  },
  "bugs": {
    "url": "https://github.com/pimbay-svc/asset-dedup-video-frame-extract/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:prod": "npm audit --omit=dev",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "js:build": "tsc -p tsconfig.build.json",
    "js:format": "prettier --check .",
    "js:format:fix": "prettier --write .",
    "js:lint": "eslint src test",
    "js:lint:fix": "eslint src test --fix",
    "js:typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/server.js",
    "test:all": "vitest run test/unit test/integration",
    "test:coverage": "vitest run --coverage test/unit test/integration",
    "test:integration": "vitest run test/integration",
    "test:mutation": "stryker run",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "awilix": "^13.0.5",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
